{
  "name": "calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "dev:desktop": "pnpm --filter @calendar/desktop dev",
    "fix": "vp check --fix",
    "ios": "pnpm --filter @calendar/ios ios",
    "knip": "knip",
    "lint": "vp check",
    "prepare": "vp config --no-agent",
    "reset:local": "bash scripts/reset-local-data.sh",
    "test": "vp test",
    "test:run": "vp test run",
    "typecheck": "pnpm --recursive --parallel --include-workspace-root exec tsc --noEmit",
    "test:e2e": "node apps/desktop/scripts/check-helper.mjs && E2E=1 vp test",
    "test:bombadil": "node apps/desktop/scripts/check-helper.mjs && E2E=1 BOMBADIL=1 vp test run apps/desktop/e2e/bombadil.e2e.ts apps/desktop/e2e/bombadilTasks.e2e.ts apps/desktop/e2e/bombadilRecurring.e2e.ts",
    "test:e2e:ios": "pnpm --filter @calendar/ios test:e2e",
    "brand:build": "node scripts/brand/build.mjs",
    "brand:check": "node scripts/brand/build.mjs --check"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^2.0.1",
    "@types/node": "^26.6.6",
    "fflate": "0.8.3",
    "knip": "^6.45.1",
    "sharp": "0.35.5",
    "tslib": "^2.9.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
