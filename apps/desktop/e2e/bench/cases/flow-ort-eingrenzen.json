        "startTime": "19:00",
        "endTime": "20:00",
        "location": null
      }
    },
    {
      "input": { "text": "im Figlmüller" },
      "expect": { "location": "figlmuller" }
    },
    {
      "input": { "text": "es ist in Salzburg" },
      "expect": { "location": "figlmuller, salzburg" }
    },
    {
      "input": { "text": "mit Anna" },
      "expect": { "title": "abendessen mit anna", "guests": {} }
    }
  ]
}
