{
  "lang": "en",
  "tags": ["flow", "task"],
  "turns": [
    {
      "input": { "text": "remind me to call the electrician tomorrow" },
      "expect": {
        "kind": "task",
        "title": "call the electrician",
        "dayOffset": 1,
        "isAllDay": true
      }
    },
    {
      "input": { "text": "at 10" },
      "expect": { "startTime": "10:00" }
    },
    {
      "input": { "text": "Thursday instead" },
      "expect": { "weekday": 4 }
    }
  ]
}
