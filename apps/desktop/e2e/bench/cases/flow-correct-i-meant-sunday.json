{
  "blind": true,
  "lang": "en",
  "tags": ["flow", "correction", "location"],
  "turns": [
    {
      "input": { "text": "Dinner Saturday at 7 at Cafe Luna" },
      "expect": {
        "title": "dinner",
        "weekday": 6,
        "startTime": "19:00",
        "endTime": "20:00",
        "location": "cafe luna"
      }
    },
    {
      "input": { "text": "I meant Sunday" },
      "expect": { "weekday": 7 }
    },
    {
      "input": { "text": "and 8, not 7" },
      "expect": { "startTime": "20:00", "endTime": "21:00" }
    }
  ]
}
