{
  "lang": "en",
  "tags": ["flow", "notifications", "task"],
  "turns": [
    {
      "input": { "text": "remind me to water the plants tomorrow at 8am" },
      "expect": {
        "kind": "task",
        "title": "water the plants",
        "dayOffset": 1,
        "startTime": "08:00"
      }
    },
    {
      "input": { "text": "alert me 5 minutes before" },
      "expect": { "kind": "task", "reminders": [5] }
    },
    {
      "input": { "text": "at 7 instead" },
      "expect": { "startTime": "07:00" }
    }
  ]
}
