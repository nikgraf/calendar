{
  "lang": "en",
  "tags": ["flow", "mixed", "guests"],
  "turns": [
    {
      "input": { "text": "Sync tomorrow at 10" },
      "expect": {
        "title": "sync",
        "dayOffset": 1,
        "startTime": "10:00",
        "endTime": "11:00",
        "guests": {}
      }
    },
    {
      "input": { "text": "make it 11 and invite Sarah" },
      "expect": {
        "startTime": "11:00",
        "endTime": "12:00",
        "guests": { "emails": ["sarah.novak@example.com"] }
      }
    },
    {
      "input": { "text": "30 minutes, and call it design sync" },
      "expect": { "startTime": "11:00", "endTime": "11:30", "title": "design sync" }
    }
  ]
}
