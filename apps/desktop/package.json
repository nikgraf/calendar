{
  "name": "@calendar/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "build": "vp build && tsdown",
    "dev": "vp dev --host 127.0.0.1",
    "dev:app": "tsdown && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "make": "vp build && tsdown && electron-forge make",
    "package:app": "vp build && tsdown && electron-forge package",
    "start": "vp build && tsdown && electron ."
  },
  "dependencies": {
    "@calendar/app-state": "workspace:*",
    "@calendar/core": "workspace:*",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^43.0.0",
    "tailwindcss": "^4.3.2",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
