{
  "expo": {
    "name": "Solunivo",
    "slug": "solunivo",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": [
      "solunivo",
      "com.googleusercontent.apps.930599242270-8u8i4aqpc4hc93ga3vn1g9lsfor4t3o0"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a4112fca-bb35-4553-a6c2-0b425ca98e98"
    },
    "ios": {
      "bundleIdentifier": "com.solunivo.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Solunivo transcribes what you say into an event entirely on this device."
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Solunivo uses the microphone to turn what you say into an event. Audio is transcribed on your device and never uploaded."
        }
      ]
    ],
    "extra": {
      "googleIosClientId": "930599242270-8u8i4aqpc4hc93ga3vn1g9lsfor4t3o0.apps.googleusercontent.com",
      "eas": {
        "projectId": "a4112fca-bb35-4553-a6c2-0b425ca98e98"
      }
    },
    "owner": "naisho-gmbh",
    "android": {
      "package": "com.solunivo.app"
    }
  }
}
